# FitForge Agent Environment Configuration
# Execution mode: 'deterministic' (local rule-based) or 'gemini' (Google ADK / Gemini 3.5 Flash)
EXECUTION_MODE=deterministic

# Gemini Configuration
GEMINI_MODEL=gemini-3.5-flash
GEMINI_API_KEY=

# Persistence Configuration: 'in_memory' (default) or 'firestore'
PERSISTENCE_BACKEND=in_memory
GOOGLE_CLOUD_PROJECT=
FIRESTORE_DATABASE=(default)
FIRESTORE_COLLECTION=workflows

# Server & Networking
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
