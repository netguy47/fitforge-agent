# FitForge Agent Environment Configuration
# Execution mode: 'deterministic' (local rule-based) or 'gemini' (Google ADK / Gemini 3.5 Flash)
EXECUTION_MODE=deterministic

# Gemini Configuration
GEMINI_MODEL=gemini-3.5-flash
GEMINI_API_KEY=

# Server & Networking
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
LOG_LEVEL=info
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
